# ==============================================================================
# Environment Variables Configuration
# Copy this file to .env and replace the values with your actual configuration.
# ==============================================================================

# Application Port
PORT=10000

# Node Environment (production, development, test)
NODE_ENV=production

# MongoDB Connection String (Required for Mongoose)
# Example local: mongodb://localhost:27017/bb-db
# Example Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://<username>:<password>@cluster.xxxxxx.mongodb.net/bb-db?retryWrites=true&w=majority

# JSON Web Token Secret Key (Must be a secure, random string)
# Min 32 characters recommended. Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_high_entropy_jwt_key_here_change_me

# Allowed Client Origin (for CORS protection)
CLIENT_URL=https://your-frontend-domain.onrender.com